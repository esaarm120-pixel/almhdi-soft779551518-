<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- رأس اللعبة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/levelText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="المرحلة 1 من 12"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="النقاط: 0"
            android:textSize="14sp"
            android:textColor="#FFD700"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/starsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌟 0"
            android:textSize="14sp"
            android:textColor="#4CAF50"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/coinsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 0"
            android:textSize="14sp"
            android:textColor="#FFC107" />
    </LinearLayout>

    <!-- مستوى الصعوبة -->
    <TextView
        android:id="@+id/difficultyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الصعوبة: سهل"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:gravity="center" />

    <!-- رسائل تحفيزية -->
    <TextView
        android:id="@+id/motivationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بداية ممتازة يا عصام المهدي"
        android:textSize="14sp"
        android:textColor="#FFD700"
        android:gravity="center"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:textStyle="bold" />

    <!-- أزرار تبديل الوضع -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/scrambleModeButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🔀 ترتيب الحروف"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/crosswordModeButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🧩 كلمات متقاطعة"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== لوحة ترتيب الحروف ===== -->
    <LinearLayout
        android:id="@+id/scramblePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/scrambleAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر الحروف لتكوين الكلمة"
            android:textSize="18sp"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:background="#2A2A2A"
            android:padding="12dp"
            android:minHeight="50dp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/lettersRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <Button
                android:id="@+id/scrambleCheckButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="✔ تحقق"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/scrambleNewButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔄 كلمة جديدة"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== لوحة الكلمات المتقاطعة ===== -->
    <LinearLayout
        android:id="@+id/crosswordPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/crosswordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="املأ الخانات - المحاولات: 3"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="#1E1E1E"
            android:padding="8dp" />

        <GridLayout
            android:id="@+id/crosswordGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_gravity="center"
            android:background="#1E1E1E"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <Button
                android:id="@+id/crosswordCheckButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="✔ تحقق"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/crosswordClearButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🧹 مسح الكل"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
