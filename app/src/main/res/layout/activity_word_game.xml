<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 المايسترو"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <GridLayout
        android:id="@+id/grid_letters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_title"
        android:layout_marginTop="30dp"
        android:rowCount="4"
        android:columnCount="4"
        android:layout_centerHorizontal="true"
        android:padding="8dp"
        android:background="#2C2C2E" />

    <TextView
        android:id="@+id/tv_selected_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/grid_letters"
        android:layout_marginTop="20dp"
        android:text=""
        android:textSize="22sp"
        android:textColor="#FFD700"
        android:gravity="center"
        android:background="#3A3A3C"
        android:padding="12dp"
        android:minHeight="60dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_selected_word"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✔ تحقق"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✖ مسح"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_shuffle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔄 خلط"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_submit"
        android:layout_marginTop="20dp"
        android:text="⭐ النقاط: 0 | الكلمات: 0"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_score"
        android:layout_marginTop="10dp"
        android:maxHeight="150dp">

        <TextView
            android:id="@+id/tv_found_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:gravity="center" />
    </ScrollView>

</RelativeLayout>
