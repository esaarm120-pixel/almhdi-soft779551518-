<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="12dp">

    <!-- رأس اللعبة -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tv_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌍 المستوى 1"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/8"
            android:textSize="18sp"
            android:textColor="#FFD700" />
    </LinearLayout>

    <!-- شريط التقدم -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_below="@id/header"
        android:layout_marginTop="8dp"
        android:progress="0"
        android:max="100"
        android:progressTint="#4CAF50" />

    <!-- ========================================== -->
    <!-- منطقة عرض عبارات عصام المهدي التحفيزية    -->
    <!-- ========================================== -->
    <TextView
        android:id="@+id/tv_motivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/progress_bar"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text=""
        android:textSize="16sp"
        android:textColor="#FFD700"
        android:gravity="center"
        android:background="#1A1A1A"
        android:padding="12dp"
        android:minHeight="50dp"
        android:textStyle="bold"
        android:alpha="0.9" />

    <!-- شبكة الأحرف 5x5 -->
    <GridLayout
        android:id="@+id/grid_letters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_motivation"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:rowCount="5"
        android:columnCount="5"
        android:background="#1E1E1E"
        android:padding="8dp" />

    <!-- الكلمة المختارة -->
    <TextView
        android:id="@+id/tv_selected_word"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/grid_letters"
        android:layout_marginTop="16dp"
        android:text=""
        android:textSize="26sp"
        android:textColor="#FFD700"
        android:gravity="center"
        android:background="#2A2A2A"
        android:padding="8dp"
        android:textStyle="bold" />

    <!-- الأزرار -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_selected_word"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_hint"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="💡 تلميح"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✔ تحقق"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✖ مسح"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- الكلمات المكتشفة -->
    <TextView
        android:id="@+id/tv_found_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_submit"
        android:layout_marginTop="12dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:minHeight="40dp" />

    <!-- زر إعادة التشغيل السري (يظهر فقط عند الحاجة) -->
    <Button
        android:id="@+id/btn_reset_game"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="🔄 إعادة المستوى"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

</RelativeLayout>
